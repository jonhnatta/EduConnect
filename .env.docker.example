# Copie para .env (docker compose le .env automaticamente) e ajuste os valores.
# cp .env.docker.example .env

# --- Postgres (servico db) ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-with-openssl-rand-base64-32
POSTGRES_DB=appdb
POSTGRES_RUNTIME_USER=app_runtime
# Use apenas letras, numeros, hifen e sublinhado para evitar URL-encoding na DATABASE_URL.
POSTGRES_RUNTIME_PASSWORD=change-runtime-password

# --- App ---
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Troque por um segredo forte: `openssl rand -base64 32`
AUTH_SECRET=dev-only-change-me
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LEGAL_CONTROLLER_NAME=EduConnect Ambiente Local
LEGAL_CONTROLLER_ID=local-test
LEGAL_CONTROLLER_ADDRESS=Endereco de teste local
LEGAL_DPO_NAME=Responsavel de teste
LEGAL_PRIVACY_EMAIL=privacidade@example.test
LEGAL_SUPPORT_EMAIL=suporte@example.test
LEGAL_FORUM=Sao Paulo/SP
LEGAL_HOSTING_PROVIDER=MinIO local
# Callback autorizado no Google Cloud:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
TRUST_PROXY_HEADERS=false
ALLOW_INSECURE_LOCAL_ORIGIN=true
APP_DOMAIN=localhost

# Redis separados: fila duravel e cache descartavel.
REDIS_QUEUE_PASSWORD=change-queue-password
REDIS_CACHE_PASSWORD=change-cache-password
REDIS_NAMESPACE=educonnect:local
CACHE_ENABLED=true

# Integracoes
RESEND_API_KEY=
EMAIL_FROM=EduConnect <no-reply@seu-dominio.com>
# Gere com: openssl rand -base64 32
EMAIL_PAYLOAD_ENCRYPTION_KEY=change-with-openssl-rand-base64-32
# Use chaves diferentes das demais aplicacoes.
ADMIN_TOTP_ENCRYPTION_KEY=change-with-openssl-rand-base64-32
ADMIN_SESSION_SECRET=change-with-openssl-rand-base64-48
CRON_SECRET=change-with-openssl-rand-base64-32
PURGE_INTERVAL_SECONDS=86400

# --- Copiloto de IA (desabilitado por padrao) ---
FEATURE_AI_COPILOT=false
FEATURE_AI_WEB_SEARCH=false
FEATURE_AI_INTERNAL_RAG=false
OPENAI_API_KEY=
OPENAI_COPILOT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_VECTOR_SCHEMA_VERSION=2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-with-openssl-rand-base64-48
QDRANT_COLLECTION=educonnect_knowledge_v2
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_WORKER_BASE_URL=http://langfuse-worker:3030
LANGFUSE_PUBLIC_KEY=pk-lf-change-for-a-dedicated-project-key
LANGFUSE_SECRET_KEY=sk-lf-change-for-a-dedicated-project-key
LANGFUSE_NEXTAUTH_SECRET=change-with-openssl-rand-base64-48
LANGFUSE_SALT=change-with-openssl-rand-base64-32
# Must be exactly 64 hexadecimal characters: `openssl rand -hex 32`
LANGFUSE_ENCRYPTION_KEY=change-with-openssl-rand-hex-32
# Keep database and Redis passwords URL-safe because they are used in connection URLs.
LANGFUSE_DB_PASSWORD=change-langfuse-db-password
LANGFUSE_CLICKHOUSE_PASSWORD=change-langfuse-clickhouse-password
LANGFUSE_REDIS_PASSWORD=change-langfuse-redis-password
LANGFUSE_MINIO_ACCESS_KEY=langfuse_change_access_key
LANGFUSE_MINIO_SECRET_KEY=change-langfuse-minio-secret-key
# Limites iniciais para beta self-hosted. Dimensione conforme a carga em producao.
QDRANT_MEM_LIMIT=1g
QDRANT_CPUS=1.0
QDRANT_PIDS_LIMIT=256
LANGFUSE_WEB_MEM_LIMIT=2g
LANGFUSE_WEB_CPUS=1.5
LANGFUSE_WEB_PIDS_LIMIT=512
LANGFUSE_WORKER_MEM_LIMIT=2g
LANGFUSE_WORKER_CPUS=1.5
LANGFUSE_WORKER_PIDS_LIMIT=512
LANGFUSE_POSTGRES_MEM_LIMIT=1g
LANGFUSE_POSTGRES_CPUS=1.0
LANGFUSE_POSTGRES_PIDS_LIMIT=256
LANGFUSE_CLICKHOUSE_MEM_LIMIT=4g
LANGFUSE_CLICKHOUSE_CPUS=2.0
LANGFUSE_CLICKHOUSE_PIDS_LIMIT=512
LANGFUSE_REDIS_MEM_LIMIT=512m
LANGFUSE_REDIS_CPUS=0.5
LANGFUSE_REDIS_PIDS_LIMIT=256
LANGFUSE_MINIO_MEM_LIMIT=1g
LANGFUSE_MINIO_CPUS=1.0
LANGFUSE_MINIO_PIDS_LIMIT=256
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_TOKEN_LIMIT=1000000

# --- Storage de objetos (MinIO / S3) ---
UPLOAD_SIMULATOR=false
S3_BUCKET=educonnect
S3_REGION=us-east-1
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-minio-root-password
S3_ACCESS_KEY=educonnect_app
S3_SECRET_KEY=troque-por-um-segredo-forte
# Para dev FORA do docker, aponte para o MinIO local; no docker o compose usa http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- Verificacao de professor ---
# O primeiro lancamento usa exclusivamente analise humana.
PROFESSOR_VERIFICATION_PROVIDER=none
MALWARE_SCAN_ENABLED=true

# --- Backup externo criptografado (perfil Docker `operations`) ---
BACKUP_STAGING_DIR=./backups
# Exemplo: s3:https://endpoint-do-provedor/bucket/educonnect
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
