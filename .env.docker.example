# Copie para .env (docker compose le .env automaticamente) e ajuste os valores.
# cp .env.docker.example .env

# --- Postgres (servico db) ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=appdb

# --- App ---
DATABASE_POOL_MAX=10
# Troque por um segredo forte: `openssl rand -base64 32`
AUTH_SECRET=dev-only-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integracoes
XAI_API_KEY=
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# --- Storage de objetos (MinIO / S3) ---
# As credenciais sao usadas tanto pelo servico minio (root) quanto pelo app.
UPLOAD_SIMULATOR=false
S3_BUCKET=educonnect
S3_REGION=us-east-1
S3_ACCESS_KEY=educonnect
S3_SECRET_KEY=troque-por-um-segredo-forte
# Para dev FORA do docker, aponte para o MinIO local; no docker o compose usa http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# --- Verificacao de professor por IA (analyze.ts) ---
# Provedor: "none" (tudo vai para analise manual) | "openai" | "xai" | "anthropic"
PROFESSOR_VERIFICATION_PROVIDER=none
# Usado quando o provedor for "openai" (modelo barato com visao)
OPENAI_API_KEY=
PROFESSOR_VERIFICATION_OPENAI_MODEL=gpt-4o-mini
