{
  "name": "educonnect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node workers/worker.mjs",
    "dispatcher": "node workers/dispatcher.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "lint": "eslint .",
    "test:oauth": "node --test tests/oauth-redirect.test.ts",
    "test:password-reset": "node --test tests/password-reset.test.ts",
    "test:cache": "node --test tests/cache-policy.test.ts",
    "test:exam-security": "node --test tests/exam-security.test.ts",
    "test:feed-pagination": "node --test tests/feed-pagination.test.ts",
    "test:production-security": "node --test tests/production-security.test.ts",
    "test:env-config": "node --test tests/environment-template.test.ts",
    "test:ai": "node --test tests/ai-*.test.ts tests/copilot-*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:oauth && npm run test:password-reset && npm run test:cache && npm run test:exam-security && npm run test:feed-pagination && npm run test:production-security && npm run test:env-config && npm run test:ai",
    "github:project": "node scripts/github-project-demand.mjs",
    "backlog:add": "node scripts/github-project-demand.mjs backlog",
    "ready:add": "node scripts/github-project-demand.mjs ready"
  },
