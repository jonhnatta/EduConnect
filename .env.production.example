# Template do Docker Compose de producao. Armazene valores reais em um cofre de
# segredos fora do repositorio e nunca reutilize credenciais entre servicos.

# Dominio e HTTPS (Caddy)
APP_DOMAIN=app.seu-dominio.com
AUTH_URL=https://app.seu-dominio.com
NEXT_PUBLIC_APP_URL=https://app.seu-dominio.com
AUTH_TRUST_HOST=true
TRUST_PROXY_HEADERS=true
ALLOW_INSECURE_LOCAL_ORIGIN=false

# Identidade legal. O readiness recusa producao enquanto estes dados nao forem reais.
LEGAL_CONTROLLER_NAME=<razao-social-ou-nome-do-controlador>
LEGAL_CONTROLLER_ID=<cnpj-ou-identificacao-aplicavel>
LEGAL_CONTROLLER_ADDRESS=<endereco-completo-cidade-uf>
LEGAL_DPO_NAME=<nome-do-encarregado-lgpd>
LEGAL_PRIVACY_EMAIL=privacidade@seu-dominio.com
LEGAL_SUPPORT_EMAIL=contato@seu-dominio.com
LEGAL_FORUM=<comarca-cidade-uf>
LEGAL_HOSTING_PROVIDER=<provedor-real-de-hospedagem-e-storage>

# Postgres: owner/migrator e runtime sao credenciais distintas.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=<openssl-rand-base64-48>
POSTGRES_DB=appdb
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=<senha-url-safe-forte>
DATABASE_POOL_MAX=10

# Autenticacao. Google e opcional; remova as duas variaveis se nao for usar OAuth.
AUTH_SECRET=<openssl-rand-base64-48>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Redis de fila e cache sao instancias logicas e volumes separados.
REDIS_QUEUE_PASSWORD=<senha-url-safe-forte>
REDIS_CACHE_PASSWORD=<senha-url-safe-forte-diferente>
REDIS_NAMESPACE=educonnect:production
CACHE_ENABLED=true

# E-mail e administracao.
RESEND_API_KEY=<chave-resend-do-dominio-verificado>
EMAIL_FROM=EduConnect <no-reply@seu-dominio.com>
EMAIL_PAYLOAD_ENCRYPTION_KEY=<openssl-rand-base64-32>
ADMIN_TOTP_ENCRYPTION_KEY=<openssl-rand-base64-32-diferente>
ADMIN_SESSION_SECRET=<openssl-rand-base64-48>
CRON_SECRET=<openssl-rand-base64-32>
PURGE_INTERVAL_SECONDS=86400

# Copiloto de IA. Mantenha desabilitado ate provisionar todos os provedores.
FEATURE_AI_COPILOT=false
FEATURE_AI_WEB_SEARCH=false
FEATURE_AI_INTERNAL_RAG=false
OPENAI_API_KEY=<chave-openai-exclusiva-do-copiloto>
OPENAI_COPILOT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_VECTOR_SCHEMA_VERSION=1
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=<openssl-rand-base64-48>
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_WORKER_BASE_URL=http://langfuse-worker:3030
LANGFUSE_PUBLIC_KEY=<chave-publica-langfuse>
LANGFUSE_SECRET_KEY=<chave-secreta-langfuse>
LANGFUSE_NEXTAUTH_SECRET=<openssl-rand-base64-48>
LANGFUSE_SALT=<openssl-rand-base64-32>
LANGFUSE_ENCRYPTION_KEY=<openssl-rand-hex-32-com-64-caracteres>
LANGFUSE_DB_PASSWORD=<senha-url-safe-forte-exclusiva>
LANGFUSE_CLICKHOUSE_PASSWORD=<senha-forte-exclusiva>
LANGFUSE_REDIS_PASSWORD=<senha-url-safe-forte-exclusiva>
LANGFUSE_MINIO_ACCESS_KEY=<credencial-exclusiva-langfuse>
LANGFUSE_MINIO_SECRET_KEY=<openssl-rand-base64-48>
# Limites iniciais para beta self-hosted. Dimensione conforme a carga observada.
QDRANT_MEM_LIMIT=1g
QDRANT_CPUS=1.0
QDRANT_PIDS_LIMIT=256
LANGFUSE_WEB_MEM_LIMIT=2g
LANGFUSE_WEB_CPUS=1.5
LANGFUSE_WEB_PIDS_LIMIT=512
LANGFUSE_WORKER_MEM_LIMIT=2g
LANGFUSE_WORKER_CPUS=1.5
LANGFUSE_WORKER_PIDS_LIMIT=512
LANGFUSE_POSTGRES_MEM_LIMIT=1g
LANGFUSE_POSTGRES_CPUS=1.0
LANGFUSE_POSTGRES_PIDS_LIMIT=256
LANGFUSE_CLICKHOUSE_MEM_LIMIT=4g
LANGFUSE_CLICKHOUSE_CPUS=2.0
LANGFUSE_CLICKHOUSE_PIDS_LIMIT=512
LANGFUSE_REDIS_MEM_LIMIT=512m
LANGFUSE_REDIS_CPUS=0.5
LANGFUSE_REDIS_PIDS_LIMIT=256
LANGFUSE_MINIO_MEM_LIMIT=1g
LANGFUSE_MINIO_CPUS=1.0
LANGFUSE_MINIO_PIDS_LIMIT=256
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_TOKEN_LIMIT=1000000

# MinIO privado. A aplicacao usa somente a service account limitada ao bucket.
MINIO_ROOT_USER=<usuario-admin-minio>
MINIO_ROOT_PASSWORD=<openssl-rand-base64-48>
S3_BUCKET=educonnect
S3_REGION=us-east-1
S3_ACCESS_KEY=educonnect_app
S3_SECRET_KEY=<openssl-rand-base64-48>
UPLOAD_SIMULATOR=false
PROFESSOR_VERIFICATION_PROVIDER=none
MALWARE_SCAN_ENABLED=true

# Compatibilidade temporaria dos handlers; o valor nao concede acesso ao MinIO.
BLOB_READ_WRITE_TOKEN=<openssl-rand-base64-32>

# Backup criptografado fora do host. O destino deve ser outro provedor/maquina.
BACKUP_STAGING_DIR=./backups
RESTIC_REPOSITORY=s3:https://endpoint-do-provedor/bucket/educonnect
RESTIC_PASSWORD=<openssl-rand-base64-48>
BACKUP_S3_ACCESS_KEY=<credencial-exclusiva-de-backup>
BACKUP_S3_SECRET_KEY=<segredo-exclusivo-de-backup>
BACKUP_S3_REGION=us-east-1
