# ─────────────────────────────────────────────────────────────────────────────
# Template de variáveis de PRODUÇÃO (segurança). Copie para o cofre do provedor
# (Vercel/host) — NUNCA commite valores reais. Veja docs/SECURITY_AUDIT.md.
# ─────────────────────────────────────────────────────────────────────────────

# M4 — OBRIGATÓRIO https em produção para o cookie de sessão ganhar a flag `Secure`.
AUTH_URL=https://seu-dominio.com
AUTH_TRUST_HOST=true

# B2 — SEGREDOS ROTACIONADOS (gere novos; os antigos vazaram em texto plano).
#   AUTH_SECRET: openssl rand -base64 48
AUTH_SECRET=<novo-secret-forte>
AUTH_GOOGLE_ID=<novo>
AUTH_GOOGLE_SECRET=<novo-revogado-e-reemitido-no-google-cloud>
OPENAI_API_KEY=<nova-revogada-e-reemitida>
XAI_API_KEY=<nova-revogada-e-reemitida>
RESEND_API_KEY=<nova-revogada-e-reemitida>
BLOB_READ_WRITE_TOKEN=<novo-revogado-e-reemitido>

# B1 — apontar para o papel de runtime SEM superuser (rodar scripts/040_runtime_role.sql).
DATABASE_URL=postgres://app_runtime:<senha-forte>@<host>:5432/appdb

# H3 — TLS do Postgres: validar o certificado do provedor (NÃO usar DATABASE_SSL_INSECURE).
#   Cole o certificado CA (PEM) numa única linha com \n, ou use o mecanismo do provedor.
DATABASE_SSL_CA=<-----BEGIN CERTIFICATE----- ...>
# DATABASE_SSL_INSECURE=true   # ⚠️ NÃO usar em produção (só self-signed em dev)

# S3/MinIO
S3_ENDPOINT=<https://...>
S3_BUCKET=educonnect
S3_ACCESS_KEY=<...>
S3_SECRET_KEY=<novo-rotacionado>
